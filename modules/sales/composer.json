{
  "name": "drongo/module-sales",
  "description": "Drongo ERP — Sales module (orders, quotes, invoicing)",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "drongo/package-core": "self.version",
    "drongo/module-inventory": "self.version"
  },
  "autoload": {
    "psr-4": {
      "Drongo\\Module\\Sales\\": "src/"
    }
  },
  "extra": {
    "drongo": {
      "module": {
        "name": "sales",
        "displayName": "Sales",
        "ownerTeam": "@drongo-org/sales-module",
        "dependsOn": ["inventory"],
        "dbSchema": "sal_",
        "namespacePrefix": "Drongo\\Module\\Sales"
      }
    }
  }
}