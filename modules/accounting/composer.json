{
  "name": "drongo/module-accounting",
  "description": "Drongo ERP — Accounting module (GL, AP, AR, invoicing)",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": "^8.1",
    "drongo/package-core": "self.version"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Drongo\\Module\\Accounting\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Drongo\\Module\\Accounting\\Tests\\": "tests/"
    }
  },
  "extra": {
    "drongo": {
      "module": {
        "name": "accounting",
        "displayName": "Accounting",
        "ownerTeam": "@Droongo/accounting-module",
        "dependsOn": [],
        "dbSchema": "acct_",
        "namespacePrefix": "Drongo\\Module\\Accounting"
      }
    }
  }
}