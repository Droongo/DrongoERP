# =============================================================================
# Drongo ERP — CODEOWNERS
# File: .github/CODEOWNERS (also mirrored at root CODEOWNERS)
# =============================================================================
# Syntax: pattern       @team-or-user   @team-or-user
# The LAST matching pattern wins.

# ---------------------------------------------------------------
# 1. Default owners — everything not explicitly claimed below
# ---------------------------------------------------------------
*                                       @Droongo/backend-leads @Droongo/platform-team

# ---------------------------------------------------------------
# 2. Module owners — each business module gets its own team
# ---------------------------------------------------------------
/modules/accounting/                    @Droongo/accounting-module
/modules/inventory/                     @Droongo/inventory-module
/modules/hr/                            @Droongo/hr-module
/modules/sales/                         @Droongo/sales-module
/modules/crm/                           @Droongo/crm-module
/modules/purchasing/                    @Droongo/purchasing-module
/modules/manufacturing/                 @Droongo/manufacturing-module
/modules/pos/                           @Droongo/pos-module
/modules/ecommerce/                     @Droongo/ecommerce-module
/modules/reporting/                     @Droongo/reporting-module

# ---------------------------------------------------------------
# 3. Shared packages (kernel, db, auth, etc.)
# ---------------------------------------------------------------
/packages/                              @Droongo/platform-team

# ---------------------------------------------------------------
# 4. Deployable applications
# ---------------------------------------------------------------
/apps/api/                              @Droongo/backend-leads
/apps/web/                              @Droongo/frontend-leads
/apps/admin/                            @Droongo/frontend-leads

# ---------------------------------------------------------------
# 5. GitHub config itself
# ---------------------------------------------------------------
/.github/                               @Droongo/repo-admins
/codeowners                             @Droongo/repo-admins
/.github/CODEOWNERS                     @Droongo/repo-admins

# ---------------------------------------------------------------
# 6. Docs & tooling (lighter review)
# ---------------------------------------------------------------
/docs/                                  @Droongo/tech-writers
/scripts/                               @Droongo/platform-team
/tools/                                 @Droongo/platform-team

# ---------------------------------------------------------------
# 7. Root files
# ---------------------------------------------------------------
/composer.json                          @Droongo/backend-leads @Droongo/platform-team
/package.json                           @Droongo/frontend-leads
/README.md                              @Droongo/tech-writers
/CONTRIBUTING.md                        @Droongo/repo-admins